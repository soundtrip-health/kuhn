# Agent Backend Configuration
# Copy to `.env` and fill in ANTHROPIC_API_KEY for the current production runtime.
# All values have defaults except the API key — see src/config.js for the full list.

# Model access (required). Alternatively, rely on Claude Code login credentials
# on a dev machine and leave this unset.
ANTHROPIC_API_KEY=

# Optional phase-one Pi runtime smoke test (not used by production agent traffic).
# Run `npm run smoke:pi-runtime`; override the default OpenRouter test model only
# when needed. The smoke never prints the credential.
# OPENROUTER_API_KEY=
# KUHN_PI_SMOKE_MODEL=openai/gpt-oss-20b:free

# Server port. For dev (two ports), this is the backend server (dev webapp is pinned to 5174).
PORT=3002

# CORS — allowed origins (comma-separated). The webapp dev server is pinned to
# 5174. Not needed for single-port deployments (webapp served by the backend):
# same-origin requests bypass CORS entirely.
CORS_ORIGIN=http://localhost:5174

# Built webapp served at / alongside the API (single-port deployment — see
# docs/deployment.md). Defaults to webapp/dist in the repo, served whenever it
# exists; set to another build directory, or to '' to disable.
# KUHN_WEBAPP_DIST=/absolute/path/to/webapp/dist

# Auth. Default mode 'dev' = no login (seeded dev user) — for
# local development. Set 'magic-link' on any shared/deployed instance; it
# requires a session secret. With no SMTP URL, sign-in links are printed to
# the server console instead of emailed.
#
# 'magic-link' is INVITE-ONLY: an address that already belongs to an org gets
# a sign-in link, and everyone else is queued as an access request for a
# super-admin to review — no account is created. See docs/deployment.md.
# KUHN_AUTH_MODE=magic-link
# KUHN_SESSION_SECRET=<openssl rand -hex 32>
# KUHN_APP_URL=https://your-public-hostname   # post-login redirect target
# KUHN_SMTP_URL=smtps://user:pass@host:465    # unset = console-log delivery

# Site super-admins, comma-separated
# Super admins can create, rename, and suspend orgs via the admin console.
# These emails are synced into the database at every boot (listed emails 
# gain the flag, unlisted lose it). In dev mode this defaults to the dev user; 
# in production there is no default, so without it nobody can create orgs.
# KUHN_SUPERADMIN_EMAILS=you@example.com

# How long org-invitation links stay valid (default 7 days).
# KUHN_INVITE_TTL_MS=604800000

# Rate limits on the sign-in form (POST /api/auth/request-link) — the only
# unauthenticated endpoint that sends mail and writes rows. Per-email is the
# limit that matters (it is keyed on the address being mailed, so it cannot be
# sidestepped); per-IP is best-effort only, since req.ip comes from
# X-Forwarded-For under `trust proxy`. Raise the per-IP cap if your users
# share one outbound address. Defaults shown.
# KUHN_LOGIN_MAX_PER_EMAIL=3
# KUHN_LOGIN_EMAIL_WINDOW_MS=900000
# KUHN_LOGIN_MAX_PER_IP=20
# KUHN_LOGIN_IP_WINDOW_MS=3600000

# Data directory: in-process SQLite DB (db/kuhn.sqlite) + uploaded project files
# (files/<projectId>/) both live here. Defaults to the repo-root ./data (gitignored).
# KUHN_DATA_DIR=/absolute/path/to/data

# Override the DB file path alone, or the project-files root alone, if needed:
# KUHN_SQLITE_PATH=/absolute/path/to/kuhn.sqlite
# PROJECTS_ROOT=/absolute/path/to/files

# Structured logging (STH-51): leveled console output plus an append-only
# NDJSON audit stream (agent job lifecycle, per-turn context-window state,
# file events, suggestion accept/reject decisions), one file per UTC day
# under <KUHN_DATA_DIR>/logs. LOG_LEVEL: debug|info|warn|error (default info).
# Set KUHN_LOG_DIR to relocate the audit files, or '' to disable the file sink.
# LOG_LEVEL=info
# KUHN_LOG_DIR=/absolute/path/to/logs
