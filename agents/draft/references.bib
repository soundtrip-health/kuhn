@article{Hietamies2023Osmind,
  author    = {Hietamies, Tuuli M and McInnes, L Alison and Klise, Andrew J and Worley, Matthew J and Qian, Jimmy J and Williams, Leanne M and Heifets, Boris D and Levine, Steven P},
