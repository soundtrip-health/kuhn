  pages     = {52--57},
  pmid      = {29908384},
  doi       = {10.1016/j.yebeh.2018.05.018},
  abstract  = {N=164 epilepsy patients. Mean PHQ-9 10.7 (SD 6.80); mean MADRS 18.5 (SD 11.3). Correlation between total PHQ-9 and total MADRS: r = 0.843 (p < .01). Severity band correspondence varied between instruments.}
}

@article{Leucht2017,
  author    = {Leucht, Stefan and Fennema, Hein and Engel, Rolf R and Kaspers-Janssen, Marion and Lepping, Peter and Szegedi, Armin},
  title     = {What does the {MADRS} mean? {Equipercentile} linking with the {CGI} using a company database of mirtazapine studies},
  journal   = {Journal of Affective Disorders},
  year      = {2017},
  volume    = {210},
  pages     = {287--293},
  pmid      = {28068617},
  doi       = {10.1016/j.jad.2016.12.041},
  abstract  = {Equipercentile linking of MADRS and CGI from 22 MDD drug trials (n=3288). CGI-I 2 (much improved) = MADRS reduction 48--57\%. CGI-I 1 (very much improved) = MADRS reduction 80--84\%. MADRS remission <8 corresponds to CGI-S 2 (borderline mentally ill).}
}

@article{Zimmerman2004,
  author    = {Zimmerman, Mark and Posternak, Michael A and Chelminski, Iwona},
  title     = {Derivation of a definition of remission on the {Montgomery-Asberg Depression Rating Scale} corresponding to the definition of remission on the {Hamilton Rating Scale for Depression}},
  journal   = {Journal of Psychiatric Research},
  year      = {2004},
  volume    = {38},
  number    = {6},
  pages     = {577--582},
  pmid      = {15458853},
  doi       = {10.1016/j.jpsychires.2004.03.007},
  abstract  = {N=303 outpatients with DSM-IV MDE. Linear regression: MADRS <=10 corresponds to HRSD <=7 (standard remission cutoff). Maximized sensitivity/specificity agreement at MADRS cutoff of 10.}
}

@article{Trivedi2004QIDS,
  author    = {Trivedi, Madhukar H and Rush, A John and Ibrahim, Hisham M and Carmody, Thomas J and Biggs, Melanie M and Suppes, Trisha and Crismon, M Lynn and Shores-Wilson, Kathy and Toprac, Marcia G and Dennehy, Ellen B and Witte, Bradley and Kashner, T Michael},
  title     = {The {Inventory of Depressive Symptomatology, Clinician Rating (IDS-C)} and {Self-Report (IDS-SR)}, and the {Quick Inventory of Depressive Symptomatology, Clinician Rating (QIDS-C)} and {Self-Report (QIDS-SR)} in public sector patients with mood disorders: a psychometric evaluation},
  journal   = {Psychological Medicine},
  year      = {2004},
  volume    = {34},
  number    = {1},
  pages     = {73--82},
  pmid      = {14971628},
  doi       = {10.1017/s0033291703001107},
  abstract  = {Psychometric evaluation of IDS-C, IDS-SR, QIDS-C, and QIDS-SR in 544 patients with MDD and 402 with bipolar disorder from 19 public-sector clinics. Internal consistencies (Cronbach's alpha) ranged from 0.81 to 0.94 for all four scales. QIDS-SR16 and IDS-SR30 demonstrated high concurrent validity (r=0.83); clinician versions showed correlations of 0.82 and 0.81 respectively. All instruments proved equivalently sensitive to symptom change. Provides QIDS severity-band mappings: remission 0--5, mild 6--10, moderate 11--15, severe 16--20, very severe 21--27.}
}

@article{vonGlischinski2021,
  author    = {von Glischinski, Michael and von Brachel, Ruth and Thiele, Christian and Hirschfeld, Gerrit},
  title     = {Not sad enough for a depression trial? {A} systematic review of depression measures and cut points in clinical trial registrations},
  journal   = {Journal of Affective Disorders},
  year      = {2021},
  volume    = {292},
  pages     = {36--44},
  pmid      = {34091381},
  doi       = {10.1016/j.jad.2021.05.041},
  abstract  = {Analyzed 2632 trials on clinicaltrials.gov (2000--2019). Clinician-administered scales dominate drug trials; self-report dominate behavioral trials. Significant differences in cut points of MADRS, HAMD-17 and PHQ-9 across intervention types.}
}

@article{Jakobsen2017,
  author    = {Jakobsen, Janus Christian and Gluud, Christian and Wetterslev, J{\o}rn and Winkel, Per},
  title     = {When and how should multiple imputation be used for handling missing data in randomised clinical trials -- a practical guide with flowcharts},
  journal   = {BMC Medical Research Methodology},
  year      = {2017},
  volume    = {17},
  number    = {1},
  pages     = {162},
  pmid      = {29207961},
  doi       = {10.1186/s12874-017-0442-1},
  abstract  = {Proposes a practical decision framework for handling missing data based on missingness thresholds: <5\% unlikely to introduce meaningful bias; 5--20\% simple methods may suffice with sensitivity analyses recommended; >20\% multiple imputation should be the primary analysis strategy and results interpreted with caution.}
}

@article{Austin2009,
  author    = {Austin, Peter C},
  title     = {Balance diagnostics for comparing the distribution of baseline covariates between treatment groups in propensity-score matched samples},
  journal   = {Statistics in Medicine},
  year      = {2009},
  volume    = {28},
  number    = {25},
  pages     = {3083--3107},
  pmid      = {19757444},
  doi       = {10.1002/sim.3697},
  abstract  = {Systematically compared balance diagnostics using Monte Carlo simulations. Recommended the standardized difference as the preferred balance diagnostic because, unlike hypothesis tests, it is not influenced by sample size. Proposed that an absolute standardized difference below 0.1 indicates negligible imbalance between treatment groups after propensity score adjustment.}
}

@article{Austin2015,
  author    = {Austin, Peter C and Stuart, Elizabeth A},
  title     = {Moving towards best practice when using inverse probability of treatment weighting ({IPTW}) using the propensity score to estimate causal treatment effects in observational studies},
  journal   = {Statistics in Medicine},
  year      = {2015},
  volume    = {34},
  number    = {28},
  pages     = {3661--3679},
  pmid      = {26238958},
  doi       = {10.1002/sim.6607},
  abstract  = {Provides practical guidance on implementing IPTW using the propensity score, including recommendations for balance diagnostics (standardized mean differences <0.1), weight truncation, and reporting standards for observational causal inference studies.}
}

@article{Jollant2023,
  author    = {Jollant, Fabrice and Colle, Romain and Nguyen, Thi Mai Loan and Corruble, Emmanuelle and Gardier, Alain M and Walter, Martin and Abbar, Mocrane and Wagner, Gerd},
  title     = {Ketamine and esketamine in suicidal thoughts and behaviors: a systematic review},
  journal   = {Therapeutic Advances in Psychopharmacology},
  year      = {2023},
  volume    = {13},
  pages     = {20451253231151327},
  pmid      = {36776623},
  doi       = {10.1177/20451253231151327},
  abstract  = {Systematic review of ketamine and esketamine for suicidal thoughts and behaviors. One single dose of IV racemic ketamine demonstrated superiority to control conditions for reducing suicidal ideation within 72 hours. Intranasal esketamine did not differ from placebo in large-scale studies. Racemic ketamine shows a favorable short-term benefit-risk profile, though caution is warranted regarding clinical implementation. Ketamine does not prevent suicidal acts or mortality in available evidence.}
}

@article{McInnes2022,
  author    = {McInnes, L Alison and Qian, Jimmy J and Gargeya, Rishab S and DeBattista, Charles and Heifets, Boris D},
  title     = {A retrospective analysis of ketamine intravenous therapy for depression in real-world care settings},
  journal   = {Journal of Affective Disorders},
  year      = {2022},
  volume    = {301},
  pages     = {486--495},
  pmid      = {35027209},
  doi       = {10.1016/j.jad.2021.12.097},
  abstract  = {Retrospective analysis of IV ketamine therapy in real-world care settings. Among patients presenting with baseline suicidal ideation, 73.0\% exhibited a reduction in SI. Overall treatment response rate was 53.6\%, and remission occurred in 28.9\% of participants. 6.0\% of patients reported increased SI.}
}

@article{Gil2024,
  author    = {Gil, Tiago and Bonetti, Tatiana CS and others},
  title     = {Efficacy of intravenous esketamine in reducing suicidal ideation and major depressive symptoms: A real-world evidence study},
  journal   = {Journal of Affective Disorders Reports},
  year      = {2024},
  volume    = {17},
  pages     = {100809},
  doi       = {10.1016/j.jadr.2024.100809},
  abstract  = {Real-world evidence study of IV esketamine. Among patients at high baseline suicide risk (PHQ-9 item 9 = 3), 84\% became low-risk after esketamine induction. Overall PHQ-9 scores declined from 20.5 +/- 4.6 to 9.8 +/- 7.0 (p < 0.001; Cohen's d = 1.47) following the induction phase.}
}

@article{OchsRoss2020TRANSFORM3,
  author    = {Ochs-Ross, Rachel and Daly, Ella J and Zhang, Yun and Lane, Rosanne and Lim, Pilar and Morrison, Randall L and Hough, David and Manji, Husseini and Drevets, Wayne C and Sanacora, Gerard and Steffens, David C and Adler, Caleb and McShane, Rupert and Gaillard, Rapha{\"e}l and Wilkinson, Samuel T and Singh, Jaskaran B},
  title     = {Efficacy and Safety of Esketamine Nasal Spray Plus an Oral Antidepressant in Elderly Patients With Treatment-Resistant Depression --- {TRANSFORM-3}},
  journal   = {American Journal of Geriatric Psychiatry},
  year      = {2020},
  volume    = {28},
  number    = {2},
  pages     = {121--141},
  pmid      = {31734084},
  doi       = {10.1016/j.jagp.2019.10.008},
  abstract  = {Randomized, double-blind, active-controlled study of esketamine nasal spray plus a newly initiated oral antidepressant vs oral antidepressant plus placebo nasal spray in patients $\geq$65 years with treatment-resistant depression. Primary endpoint (change in MADRS total score at Day 28) showed a clinically meaningful treatment difference (median-unbiased estimate $-3.6$; 95\% CI [$-7.20$, $0.07$]; weighted combination test $z = 1.89$, two-sided $p = 0.059$) that did not achieve statistical significance. Greater treatment effects were observed in patients aged 65--74 years (adjusted mean difference $-4.9$) vs $\geq$75 years ($-0.4$), and in patients with depression onset before age 55 ($-6.1$) vs $\geq$55 years ($3.1$). Patients continuing into the open-label extension showed continued improvement. Safety profile was consistent with the known esketamine profile; dizziness, nausea, and dissociation were the most common treatment-emergent adverse events.}
}

