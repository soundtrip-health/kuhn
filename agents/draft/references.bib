  pmid      = {12197453},
  doi       = {10.4088/jcp.v63n0810},
  abstract  = {A treatment pattern algorithm was applied to classify adult MDD patients into TRD-likely and TRD-unlikely groups using claims data. Consistent with the epidemiologic literature, the algorithm classified 12\% of the MDD sample as TRD-likely. It is feasible to use an administrative dataset to develop a claim-based treatment algorithm to identify TRD-likely patients.}
}

@article{Pilon2019TRD,
  author    = {Pilon, Dominic and Joshi, Kruti and Sheehan, John J and Zichlin, Miriam L and Zuckerman, Peter and Lefebvre, Patrick and Greenberg, Paul E},
  title     = {Burden of treatment-resistant depression in {Medicare}: A retrospective claims database analysis},
  journal   = {PLoS One},
